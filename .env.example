# Corporate Carpooling Platform — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# SETUP
#   Local dev: Copy to .env.local  →  cp .env.example .env.local
#   Docker:    Copy to .env        →  cp .env.example .env
#
# For local development, no PostgreSQL server is required: use STORAGE_MODE=memory.
# For Docker/staging/production, use STORAGE_MODE=postgres and DATABASE_URL.
# Never commit .env or .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────────────────────────────────
# Local development default: memory (data resets when the server restarts).
# PostgreSQL mode: postgres (requires DATABASE_URL).
STORAGE_MODE=memory

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (required only when STORAGE_MODE=postgres)
#
# Local:  postgresql://<user>:<password>@localhost:5432/<dbname>
# Docker: Set this to match POSTGRES_* variables below, e.g.:
#         postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
#
# Leave blank for local memory mode. Use a real URL for PostgreSQL mode.
DATABASE_URL=

# Docker Compose — used to create the PostgreSQL container
POSTGRES_USER=carpool
POSTGRES_PASSWORD=changeme-set-a-real-password-here
POSTGRES_DB=carpool_db

# ─────────────────────────────────────────────────────────────────────────────
# JWT Signing Secret (REQUIRED)
# Minimum 32 characters. Use a cryptographically random value.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-secure-random-secret-at-least-64-characters-long

# ─────────────────────────────────────────────────────────────────────────────
# Google Maps (required for routing and location autocomplete features)
# ─────────────────────────────────────────────────────────────────────────────
#
# Server-side key (CONFIDENTIAL) — Never expose to client-side code:
#   Must enable in Google Cloud Console:
#     - Places API (New) AND/OR Places API (Legacy)
#     - Directions API
#     - Geocoding API
#   Used securely server-side by /api/v1/routing/places, /api/v1/routing/place-details, and /api/v1/routing/directions
GOOGLE_MAPS_API_KEY=
#
# Client-side key (PUBLIC) — Sent to browser for interactive map tile rendering:
#   Must enable in Google Cloud Console:
#     - Maps JavaScript API
#   Restrict key by HTTP Referrer in Google Cloud Console (e.g. http://localhost:3000/*, https://yourdomain.com/*)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Cron Worker Authentication (REQUIRED)
# Used by the expiration worker to call /api/v1/system/cron/expire
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
CRON_SECRET=replace-with-a-secure-random-32-char-secret

# ─────────────────────────────────────────────────────────────────────────────
# Application URL (used by db:seed and staging:verify scripts)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local development seed admin password (never use in staging/production)
SEED_ADMIN_PASSWORD=
